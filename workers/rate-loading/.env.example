# Navigator API the worker talks to (alias: NAVIGATOR_API_BASE)
APP_BASE_URL=
# Same value as the app secret RATE_LOADING_WORKER_TOKEN (alias: RATE_LOADING_WORKER_TOKEN)
RATE_LOADING_WORKER_KEY=

# Browserbase — the API key resolves the project automatically;
# no BROWSERBASE_PROJECT_ID is needed.
BROWSERBASE_API_KEY=

# Optional: Claude id supported by the Browserbase Model Gateway, or leave
# unset / "auto" to let the gateway pick the model.
RATE_LOADING_MODEL=auto

# Optional: comma-separated SSO/login domains beyond the connection host
INFOTRAVEL_EXTRA_DOMAINS=

# browserbase (default) | local (Playwright + mock portal)
BROWSER_PROVIDER=browserbase
